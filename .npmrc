engine-strict=true

# SvelteKit 3 (100226): better-auth 1.7.x still declares a peer of @sveltejs/kit ^2.0.0. Its SvelteKit
# glue only touches APIs SvelteKit 3 kept (request, resolve, building, getRequestEvent, cookies.set), so
# the range is stale, not a real incompatibility. Remove this once better-auth lists ^3.
legacy-peer-deps=true
