{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "sveltekit",
	"buildCommand": "node regenerate-data.js canonical.json && npm run build",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				}
			]
		},
		{
			"source": "/(.*)",
			"has": [
				{
					"type": "host",
					"value": "hooker-test.vercel.app"
				}
			],
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				}
			]
		},
		{
			"source": "/cld/(.*)",
			"headers": [
				{
					"key": "x-vercel-enable-rewrite-caching",
					"value": "1"
				},
				{
					"key": "CDN-Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/data/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, stale-while-revalidate=86400"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/cld/:path*",
			"destination": "https://res.cloudinary.com/dc5clrqtw/image/upload/:path*"
		}
	],
	"redirects": [
		{
			"source": "/(.*)",
			"has": [
				{
					"type": "host",
					"value": "www.hookerverse.com"
				}
			],
			"destination": "https://hookerverse.com/$1",
			"permanent": true
		}
	]
}
